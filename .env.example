# Copy to .env and adjust. Never commit the real .env.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
TIME_ZONE=Africa/Nairobi

# --- Database ---
POSTGRES_DB=hardwareos
POSTGRES_USER=hardwareos
POSTGRES_PASSWORD=hardwareos
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- CORS (Next.js dev) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- AI service shared token (service-to-service) ---
AI_SERVICE_TOKEN=

# --- Production only ---
# CSRF_TRUSTED_ORIGINS=https://app.yourdomain.com
