# Copy to .env. Never commit the real .env.

# Base URL of the HardwareOS REST API (v1).
# In docker compose this is the Django service: http://web:8000/api/v1
HARDWAREOS_API_URL=http://localhost:8000/api/v1
REQUEST_TIMEOUT_SECONDS=15

# Anthropic — leave blank to use the deterministic (rule-based) engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=800

CORS_ALLOW_ORIGINS=http://localhost:3000
